# 4. ПРОВЕРКА И СОХРАНЕНИЕ
if st.button("🚀 Узнать результат"):
    if not user_name.strip():
        st.warning("Пожалуйста, введи своё имя перед отправкой!")
    else:
        # Подсчет баллов
        score = 0
        if q1 == "США🇺🇸":
            score += 1
        if q2 == "Backend / Внутренние системы":
            score += 1
        if q3 == "Любимый энергетик / кофе":
            score += 1
